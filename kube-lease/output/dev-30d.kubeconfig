apiVersion: v1
kind: Config
clusters:
- name: kubernetes
  cluster:
    server: https://10.0.0.1:6443
    certificate-authority-data: 
users:
- name: dev
  user:
    client-certificate-data: 
    client-key-data: 
contexts:
- name: dev@kubernetes
  context:
    cluster: kubernetes
    user: dev
current-context: dev@kubernetes
